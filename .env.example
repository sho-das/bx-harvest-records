# Copy to .env and fill in.

DATABASE_URL=postgres://localhost:5432/bx_harvest
PORT=3000

# 'anthropic' or 'mock'. Mock returns one fixed filter and needs no key.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# How long to wait for the model, in milliseconds. Optional; 15000 if unset.
# The SDK's own default is 10 minutes, which is far too long for a request a
# person is waiting on. Anything missing or unparseable falls back to 15000,
# including 0 - the SDK reads 0 as "wait forever".
ANTHROPIC_TIMEOUT_MS=15000
